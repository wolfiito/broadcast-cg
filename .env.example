# Copia a .env.local (NO se versiona). Los parámetros de URL tienen prioridad.
VITE_FREESHOW_HOST=localhost
VITE_FREESHOW_PORT=5505
# Contraseña de la API de FreeShow (Settings > Connections > API), si la configuraste.
# No la escribas en el código ni la pongas en la URL de una escena compartida.
VITE_FREESHOW_TOKEN=

# Control de escenas de OBS desde el celular (obs-websocket, OBS > Herramientas > Ajustes de WebSocket).
# Solo las lee el servidor del CG; nunca llegan al navegador. "off" desactiva el control de OBS.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
